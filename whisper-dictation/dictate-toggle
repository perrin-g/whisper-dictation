#!/usr/bin/env bash
# Toggle dictation: first invocation starts recording, second stops, transcribes,
# and types the result into the focused window via the RemoteDesktop portal.
#
# Run with --retype to re-type the last transcript into the window that has focus
# now - the recovery path for when focus moved, or the inject failed, and the
# words would otherwise be lost.
#
# State lives in $XDG_RUNTIME_DIR (user-only tmpfs). A flock guards against
# double-press races. The recorder/transcriber/typer are overridable via env
# vars so the state machine can be exercised with stubs in tests.
set -euo pipefail

BASE="${WD_BASE:-$HOME/.local/share/whisper-dictation}"
PY="$BASE/venv/bin/python"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
WAV="$RUNTIME/dictate.wav"
PIDFILE="$RUNTIME/dictate.pid"
LOCK="$RUNTIME/dictate.lock"
# Last transcript, kept for --retype. Written 0600 before the inject is attempted
# so a failed or misdirected type is always recoverable. On tmpfs it never
# reaches disk and dies with the login session - but note that RUNTIME falls back
# to /tmp, which may be real disk, if XDG_RUNTIME_DIR is unset.
LAST="$RUNTIME/dictate.last"

# Overridable commands (defaults are the real tools).
RECORD_CMD="${WD_RECORD_CMD:-pw-record --rate 16000 --channels 1 --format s16}"
TRANSCRIBE_CMD="${WD_TRANSCRIBE_CMD:-$PY $BASE/transcribe.py}"
TYPE_CMD="${WD_TYPE_CMD:-$PY $BASE/portal_type.py}"
NOTIFY_CMD="${WD_NOTIFY_CMD:-notify-send}"
# Clipboard fallback, used only when an inject fails. wl-copy stays resident to
# own the selection, so it is always launched detached with the lock FD closed.
CLIP_CMD="${WD_CLIP_CMD:-wl-copy}"
# Service start, overridable so tests never trigger a real consent prompt.
DAEMON_START_CMD="${WD_DAEMON_START_CMD:-systemctl --user start whisper-typist}"

notify() { $NOTIFY_CMD "Dictation" "$1" 2>/dev/null || true; }

# Transcripts are not echoed in full: notifications persist in the shell's
# notification history, and a whole dictated sentence does not belong there.
notify_text() {
  local label="$1" text="$2"
  if [ "${#text}" -gt 40 ]; then
    notify "$label: ${text:0:40}... (${#text} chars)"
  else
    notify "$label: $text"
  fi
}

start_daemon() {
  # Bypass systemd's RestartSec so the consent dialog appears now rather than
  # after the restart delay. Detached, with the lock FD closed.
  # shellcheck disable=SC2086
  $DAEMON_START_CMD </dev/null >/dev/null 2>&1 9>&- &
}

# Put text on the clipboard so a failed inject never loses it. Best-effort: a
# missing wl-copy is not an error, the stash is the real safety net.
to_clipboard() {
  command -v "${CLIP_CMD%% *}" >/dev/null 2>&1 || return 0
  # No stdin redirect here: the text arrives through the pipe. The whole pipeline
  # is backgrounded so wl-copy can hold the selection without blocking us.
  # shellcheck disable=SC2086
  printf '%s' "$1" | $CLIP_CMD >/dev/null 2>&1 9>&- &
}

# Mic selection: prefer a connected headset (Bluetooth or USB), else the
# built-in mic. WD_SOURCE names a node to prefer over the ranking (it still
# falls back when that device isn't connected).
PICK_SOURCE_CMD="${WD_PICK_SOURCE_CMD:-$BASE/pick-source}"
SRC_TARGET=""   # node.name for pw-record --target ("" = PipeWire default)
SRC_ID="@DEFAULT_AUDIO_SOURCE@"   # node id for wpctl
SRC_DESC=""     # human-readable name, for notifications

resolve_source() {
  local line
  # shellcheck disable=SC2086
  line="$($PICK_SOURCE_CMD "${WD_SOURCE:-}" 2>/dev/null || true)"
  # No capture device found (or the probe failed): leave the defaults in place
  # and let pw-record pick the default source, as it did before.
  [ -n "$line" ] || return 0
  SRC_ID="$(printf '%s' "$line" | cut -f1)"
  SRC_TARGET="$(printf '%s' "$line" | cut -f2)"
  SRC_DESC="$(printf '%s' "$line" | cut -f3)"
}

# True if the chosen audio source is muted. Overridable for tests; a missing
# wpctl (or any probe failure) is treated as "not muted" so dictation still works.
MUTE_CHECK_CMD="${WD_MUTE_CHECK_CMD:-wpctl get-volume}"
mic_muted() {
  # shellcheck disable=SC2086
  $MUTE_CHECK_CMD "$SRC_ID" 2>/dev/null | grep -q MUTED
}

DAEMON_CHECK_CMD="${WD_DAEMON_CHECK_CMD:-}"

daemon_alive() {
  # Probe liveness with an actual connect, not just file existence - a stale
  # socket from a crashed daemon would pass [ -S ] but fail here.
  if [ -n "$DAEMON_CHECK_CMD" ]; then
    $DAEMON_CHECK_CMD
  else
    local sock="$RUNTIME/whisper-dictation.sock"
    [ -S "$sock" ] && socat -u /dev/null "UNIX-CONNECT:$sock" 2>/dev/null
  fi
}

start_recording() {
  if ! daemon_alive; then
    notify "starting Whisper Dictation - approve the prompt, then press the dictation key"
    start_daemon
    return
  fi
  resolve_source
  if mic_muted; then
    notify "${SRC_DESC:-mic} is muted - unmute to dictate"
    return
  fi
  # Safety net: kill any orphaned recorder before starting a new one so we never
  # have two pw-record processes writing to the same wav concurrently.
  _kill_orphaned_recorder
  # Pin the recorder to the chosen mic; with no target it would follow whatever
  # PipeWire's default source happens to be.
  local target=()
  [ -n "$SRC_TARGET" ] && target=(--target "$SRC_TARGET")
  # Detach the recorder's stdio and close the lock FD (9) in the child so it
  # neither holds the caller's pipes nor the flock for the whole recording -
  # otherwise the next press deadlocks. shellcheck disable=SC2086
  $RECORD_CMD "${target[@]}" "$WAV" </dev/null >/dev/null 2>&1 9>&- &
  echo $! > "$PIDFILE"
  if [ -n "$SRC_DESC" ]; then
    notify "recording via $SRC_DESC (press again to stop)"
  else
    notify "recording... (press again to stop)"
  fi
}

stop_and_transcribe() {
  local pid
  pid="$(cat "$PIDFILE")"
  rm -f "$PIDFILE"
  # Guard against a stale PIDFILE whose PID was recycled by an unrelated process.
  if kill -0 "$pid" 2>/dev/null && grep -q "pw-record" /proc/"$pid"/cmdline 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi

  if [ ! -s "$WAV" ]; then
    notify "no audio captured"
    rm -f "$WAV"
    return
  fi

  local text
  # shellcheck disable=SC2086
  if ! text="$($TRANSCRIBE_CMD "$WAV")"; then
    notify "transcribe failed"
    rm -f "$WAV"
    return
  fi
  rm -f "$WAV"

  # strip a trailing newline so we never accidentally submit a form/command
  text="${text%$'\n'}"

  if [ -z "$text" ]; then
    notify "nothing transcribed"
    return
  fi

  # Stash BEFORE attempting the inject: if the type fails, or lands in a window
  # that stole focus while we were transcribing, --retype is the way back and it
  # needs the text to already be on disk.
  stash_text "$text"

  # shellcheck disable=SC2086
  if printf '%s' "$text" | $TYPE_CMD; then
    notify_text "typed" "$text"
  else
    # Clipboard first: the daemon restart below raises a consent dialog, and the
    # text must already be safe before anything else can go wrong.
    to_clipboard "$text"
    notify "type failed - approve the prompt, then press the retype key (also on clipboard)"
    # Daemon exited due to lost portal session.
    start_daemon
  fi
}

stash_text() {
  # 0600 via umask in a subshell: the file holds dictated speech, and the tester's
  # umask must not be able to widen it.
  (umask 077; printf '%s' "$1" > "$LAST")
}

retype_last() {
  if [ ! -s "$LAST" ]; then
    notify "nothing to retype"
    return
  fi
  local text
  text="$(cat "$LAST")"
  # shellcheck disable=SC2086
  if printf '%s' "$text" | $TYPE_CMD; then
    notify_text "retyped" "$text"
    # Deliberately NOT cleared: a retype can land in the wrong window too, and
    # that is exactly when a second attempt is needed. The next dictation
    # overwrites it.
  else
    to_clipboard "$text"
    notify "retype failed - approve the prompt and try again (also on clipboard)"
    start_daemon
  fi
}

_kill_orphaned_recorder() {
  # Kill any pw-record still writing to the wav (e.g. orphaned after session lock
  # broke the PIDFILE so stop_and_transcribe could not kill it normally).
  pkill -f "pw-record.*${WAV##*/}" 2>/dev/null || true
}

main() {
  local mode="toggle"
  case "${1:-}" in
    "")        mode="toggle" ;;
    --retype)  mode="retype" ;;
    # Fail loudly: a typo in the hotkey's command must not silently fall through
    # to starting a recording.
    *)         notify "unknown option: $1"; exit 2 ;;
  esac

  exec 9>"$LOCK"
  # Non-blocking: if another invocation holds the lock (e.g. a transcribe is
  # in progress), drop this press rather than queueing it - avoids stacking.
  flock -n 9 || { notify "busy, ignoring press"; exit 0; }

  # Retype never touches the recorder state, so it is safe to press mid-recording.
  if [ "$mode" = "retype" ]; then
    retype_last
    return
  fi

  if [ -f "$PIDFILE" ]; then
    local pid
    pid="$(cat "$PIDFILE")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      stop_and_transcribe
    else
      _kill_orphaned_recorder
      notify "previous recording lost (session interrupted)"
      rm -f "$PIDFILE" "$WAV"
      start_recording
    fi
  else
    start_recording
  fi
}

main "$@"
